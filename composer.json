{
    "name": "zoclee/fluxq",
    "description": "FluxQ is a unified message broker built for reliability, extensibility, and interoperability, with a pure PHP core and PostgreSQL persistence.",
    "type": "project",
    "license": "MIT",
    "bin": [
        "fluxq"
    ],
    "require": {
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "php": "^8.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "FluxQ\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FluxQ\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
